generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  analyses Analysis[]
}

model Analysis {
  id               Int      @id @default(autoincrement())
  title            String?
  url              String?
  articleText      String?
  summary          String?
  fakeScore        Float?
  credibilityScore Float?
  bias             String?
  sentiment        String?
  createdAt        DateTime @default(now())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
}